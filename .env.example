# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxx
CLAUDE_MODEL=claude-sonnet-5

# Run mode: local (sqlite, no AWS needed) | aws (dynamodb + opensearch + ses)
CONTINUUM_ENV=local

# AWS (only needed when CONTINUUM_ENV=aws)
AWS_REGION=ap-south-1
CHECKPOINT_TABLE_NAME=continuum-checkpoints-dev
OPENSEARCH_COLLECTION_ENDPOINT=
REPORTS_BUCKET_NAME=continuum-reports-dev
SES_SENDER_ADDRESS=research-bot@example.com
SES_RECIPIENT_ADDRESS=you@example.com
